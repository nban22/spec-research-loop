# =============================================================================
# backend/.env  — copy file này sang backend/.env rồi điền giá trị thật
# Chi tiết từng biến: docs/STACK.md §6
# =============================================================================

# Postgres qua connection string — Neon. Không dựng Docker.
DATABASE_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/specresearch?sslmode=require"
PORT=3001

# LLM — DeepSeek only (docs/STACK.md §2). Lấy key: https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Search nguồn thật (docs/STACK.md §1 ràng buộc 2)
# Key dạng s2k-… gửi ở header `x-api-key`. Xin tại https://www.semanticscholar.org/product/api#api-key
# Optional: bỏ trống thì client dùng pool chung và fallback OpenAlex, app vẫn boot.
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_MAILTO=you@example.com      # vào polite pool, rate limit rộng hơn
  
# Auth (docs/STACK.md §11). Sinh secret: openssl rand -base64 48
# Hai secret PHẢI khác nhau.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=1h
JWT_REFRESH_TTL=7d

# =============================================================================
# frontend/.env.local
# =============================================================================

BACKEND_ORIGIN=http://localhost:3001  # dùng cho rewrites() trong next.config.ts

# =============================================================================
# Chỉ dùng cho MCP lúc dev, app không đọc. Lấy key: https://context7.com/dashboard
# =============================================================================

CONTEXT7_API_KEY=
