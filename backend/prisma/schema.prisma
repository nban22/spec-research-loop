// ERD do docs/ARCHITECTURE.md §2 định nghĩa. File này chỉ hiện thực hoá.
// Field giữ snake_case đúng như backend/CLAUDE.md §1 — không đổi sang camelCase ở tầng nào.
// Enum phải khớp 1-1 với zod enum ở src/contracts/enums.ts (STACK §3.1 luật 1).

// Prisma 7: generator là `prisma-client` (không có `-js`), `output` bắt buộc,
// và URL kết nối nằm ở `prisma.config.ts` chứ không ở block `datasource`.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- enums

enum ProjectStep {
  S1
  S2
  S3
  S4
  S5
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  FINAL
}

enum Arm {
  B1
  B2
  SYS
  SYS_NO_VERIFY
}

enum SpecVersionStatus {
  DRAFT
  UNDER_REVIEW
  ACCEPTED
  FINAL
}

enum CardType {
  PROBLEM
  RESEARCH_QUESTION
  GAP
  CONTRIBUTION
  CLAIM
  EVIDENCE
  CONSTRAINT
  OPEN_QUESTION
}

enum CardStatus {
  CONFIRMED
  PROPOSED
  MISSING
  AMBIGUOUS
  UNSUPPORTED
  CONFLICT
}

enum CardOrigin {
  GENERATOR
  USER
  JUDGE_FIX
}

// Không tồn tại giá trị LLM — kiểu dữ liệu là chỗ chặn rủi ro "LLM bịa paper" (ARCHITECTURE §2.4).
enum SourceProvider {
  SEMANTIC_SCHOLAR
  OPENALEX
  ARXIV
  CROSSREF
}

enum SupportLabel {
  SUPPORTED
  WEAK
  UNSUPPORTED
}

enum Entailment {
  ENTAILS
  PARTIAL
  NOT_ENTAILED
  CONTRADICTS
}

enum JudgeKey {
  J1
  J2
  J3
  J4
  J5
}

enum JudgeRunStatus {
  OK
  FAILED
}

enum Severity {
  CRITICAL
  MAJOR
  MINOR
}

enum IssueGroupStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum DecisionActor {
  USER
  SCRIPTED
}

enum JobKind {
  ANALYZE
  SEARCH
  RELATED_WORK
  GENERATE
  JUDGE
  VERIFY
  EXPORT
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum LlmPurpose {
  PARAPHRASE
  DECOMPOSE
  RELATED_WORK
  GAP
  CLAIM
  EXPERIMENT
  OPTIONS
  JUDGE
  ENTAILMENT
  AUDITOR
  B1_SINGLE_SHOT
}

enum ExportFormat {
  MD
  PDF
}

// ---------------------------------------------------------------- auth

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  display_name  String
  created_at    DateTime @default(now())

  refresh_tokens RefreshToken[]
  projects       Project[]
}

model RefreshToken {
  id         String    @id @default(uuid())
  user_id    String
  token_hash String
  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token_hash])
}

// ---------------------------------------------------------------- lõi

model Project {
  id                      String        @id @default(uuid())
  user_id                 String
  title                   String
  raw_idea                String
  domain                  String?
  step                    ProjectStep   @default(S1)
  status                  ProjectStatus @default(DRAFT)
  current_spec_version_id String?
  arm                     Arm           @default(SYS)
  verifier_gate           Boolean       @default(true)
  // Vòng judge **trong version hiện tại** — reset khi apply quyết định, vì
  // `JudgeRun` unique theo `(spec_version_id, judge_key, round)`.
  judge_round             Int           @default(0)
  // Vòng judge **tính cả dự án** — không bao giờ reset. Đây mới là bộ đếm chặn
  // ở `MAX_JUDGE_ROUNDS` (ARCHITECTURE §1.2 "tối đa 3 vòng judge cho mỗi project").
  // Trước khi có cột này, `apply` reset `judge_round = 0` nên giới hạn không bao giờ tới.
  judge_rounds_total      Int           @default(0)
  // Cờ của làn B · #7. Mặc định **tắt** theo luật chung 1: nhánh chưa merge không được đổi
  // hành vi demo của ai, và chính cờ này là cần gạt để chạy ablation ở #13.
  overclaim_detector      Boolean       @default(false)
  // Cờ của làn B · #12. Mặc định **tắt** theo luật chung 1.
  ambiguity_detector      Boolean       @default(false)
  // Cờ của làn A · #1. Bật thì danh sách nguồn ở bước 2 có mức tin cậy và cảnh báo thẻ chỉ
  // dựa vào nguồn yếu. Mặc định **tắt** theo luật chung 1; cũng là cần gạt cho ablation ở #6.
  source_credibility      Boolean       @default(false)
  // Cờ của làn A · #2. Bật thì verifier leo thang xuống toàn văn arXiv khi abstract không kết
  // luận nổi. Tắt ⇒ hành vi **y hệt** bản MVP, đây là tiêu chí hoàn thành số 1 của #2.
  evidence_fulltext       Boolean       @default(false)
  // Cờ của làn A · #3. Bật thì verifier đối chiếu các nguồn **với nhau** và gán `CONFLICT`.
  conflict_detector       Boolean       @default(false)
  created_at              DateTime      @default(now())
  updated_at              DateTime      @updatedAt

  user          User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  spec_versions SpecVersion[] @relation("ProjectVersions")
  sources       Source[]
  decisions     Decision[]
  job_runs      JobRun[]
  llm_calls     LlmCall[]
  eval_runs     EvalRun[]

  @@index([user_id])
}

model SpecVersion {
  id                     String            @id @default(uuid())
  project_id             String
  version_no             Int
  parent_version_id      String?
  created_by_decision_id String?
  status                 SpecVersionStatus @default(DRAFT)
  label                  String?
  // Diễn giải lại ý tưởng, mức chắc chắn, vấn đề chính, từ khoá tìm kiếm.
  // Thuộc về version chứ không thuộc project: chạy lại analyze là ra bản diễn giải khác.
  meta                   Json?
  created_at             DateTime          @default(now())

  project        Project       @relation("ProjectVersions", fields: [project_id], references: [id], onDelete: Cascade)
  parent_version SpecVersion?  @relation("VersionLineage", fields: [parent_version_id], references: [id])
  child_versions SpecVersion[] @relation("VersionLineage")
  created_by     Decision?     @relation("DecisionCreatesVersion", fields: [created_by_decision_id], references: [id])

  cards             Card[]
  related_work_rows RelatedWorkRow[]
  experiment_plan   ExperimentPlan?
  resource_estimate ResourceEstimate?
  export_artifacts  ExportArtifact[]
  judge_runs        JudgeRun[]
  issue_groups      IssueGroup[]
  verifier_runs     VerifierRun[]
  decisions         Decision[]        @relation("DecisionAskedAtVersion")
  resulting_of      Decision[]        @relation("DecisionResultsInVersion")
  job_runs          JobRun[]
  llm_calls         LlmCall[]

  @@unique([project_id, version_no])
  @@index([project_id])
}

model Card {
  id                    String     @id @default(uuid())
  spec_version_id       String
  type                  CardType
  status                CardStatus
  title                 String
  body                  String
  payload               Json?
  order_index           Int        @default(0)
  parent_card_id        String?
  origin                CardOrigin @default(GENERATOR)
  conflict_with_card_id String?
  created_at            DateTime   @default(now())

  spec_version SpecVersion @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)
  parent_card  Card?       @relation("CardTree", fields: [parent_card_id], references: [id])
  child_cards  Card[]      @relation("CardTree")

  card_sources CardSource[]
  issues       Issue[]

  @@index([spec_version_id])
  @@index([spec_version_id, type])
}

model Source {
  id             String         @id @default(uuid())
  project_id     String
  retrieved_from SourceProvider
  external_id    String
  title          String
  authors        Json
  year           Int?
  venue          String?
  doi            String?
  url            String?
  abstract       String?
  citation_count Int?
  raw            Json
  doi_verified   Boolean?
  retrieved_at   DateTime       @default(now())
  created_at     DateTime       @default(now())

  project           Project          @relation(fields: [project_id], references: [id], onDelete: Cascade)
  card_sources      CardSource[]
  related_work_rows RelatedWorkRow[]

  @@unique([project_id, retrieved_from, external_id])
  @@index([project_id])
  @@index([doi])
}

model CardSource {
  id                String       @id @default(uuid())
  card_id           String
  source_id         String
  support_label     SupportLabel @default(WEAK)
  similarity        Float?
  entailment        Entailment?
  confidence        Float?
  evidence_sentence String?
  flags             Json?
  verifier_run_id   String?
  // Người dùng chọn "Other" ở verifier gate: giữ nguyên trích dẫn dù bị gắn `UNSUPPORTED`,
  // kèm lý do bắt buộc (ARCHITECTURE §6.6). Gate bỏ qua cặp có lý do, và file xuất ra
  // **đánh dấu** nó — đó là chỗ khác nhau giữa *bỏ qua có ghi nhận* và *không kiểm*.
  override_reason   String?
  created_at        DateTime     @default(now())

  card         Card         @relation(fields: [card_id], references: [id], onDelete: Cascade)
  source       Source       @relation(fields: [source_id], references: [id], onDelete: Cascade)
  verifier_run VerifierRun? @relation(fields: [verifier_run_id], references: [id])
  human_checks HumanCheck[]

  @@unique([card_id, source_id])
  @@index([card_id])
  @@index([source_id])
}

model RelatedWorkRow {
  id              String   @id @default(uuid())
  spec_version_id String
  source_id       String
  what_done       String
  feedback_type   String
  what_missing    String
  order_index     Int      @default(0)
  created_at      DateTime @default(now())

  spec_version SpecVersion @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)
  source       Source      @relation(fields: [source_id], references: [id], onDelete: Cascade)

  @@index([spec_version_id])
}

// ---------------------------------------------------------------- judge

model JudgeRun {
  id              String         @id @default(uuid())
  spec_version_id String
  judge_key       JudgeKey
  round           Int
  model           String
  prompt_id       String
  prompt_hash     String
  input_digest    String
  raw_output      Json
  parse_attempts  Int            @default(1)
  status          JudgeRunStatus @default(OK)
  error_code      String?
  job_id          String?
  started_at      DateTime       @default(now())
  finished_at     DateTime?
  created_at      DateTime       @default(now())

  spec_version SpecVersion @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)
  job          JobRun?     @relation(fields: [job_id], references: [id])
  issues       Issue[]
  llm_calls    LlmCall[]

  @@unique([spec_version_id, judge_key, round])
  @@index([spec_version_id])
}

model Issue {
  id             String   @id @default(uuid())
  judge_run_id   String
  issue_group_id String?
  severity       Severity
  title          String
  reason         String
  suggestion     String
  target_card_id String?
  created_at     DateTime @default(now())

  judge_run   JudgeRun    @relation(fields: [judge_run_id], references: [id], onDelete: Cascade)
  issue_group IssueGroup? @relation(fields: [issue_group_id], references: [id])
  target_card Card?       @relation(fields: [target_card_id], references: [id])

  @@index([judge_run_id])
  @@index([issue_group_id])
}

model IssueGroup {
  id                 String           @id @default(uuid())
  spec_version_id    String
  round              Int              @default(1)
  canonical_title    String
  max_severity       Severity
  judge_keys         Json
  agreement_count    Int
  judges_completed   Int
  disagreement_score Float
  status             IssueGroupStatus @default(OPEN)
  created_at         DateTime         @default(now())

  spec_version SpecVersion @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)
  issues       Issue[]
  decisions    Decision[]

  @@index([spec_version_id])
}

// ---------------------------------------------------------------- quyết định

model Decision {
  id                        String        @id @default(uuid())
  project_id                String
  spec_version_id           String
  step                      ProjectStep
  issue_group_id            String?
  question                  String
  options                   Json
  chosen_key                String
  custom_text               String?
  actor                     DecisionActor @default(USER)
  // Bản nháp thay đổi đã tính lúc `POST /decisions` và đã hiện trong DiffView.
  // Lưu lại để `apply` áp **đúng** thứ người dùng đã duyệt — tính lại bằng LLM lúc apply thì
  // diff đã xem và thứ được ghi có thể khác nhau.
  draft                     Json?
  applied                   Boolean       @default(false)
  resulting_spec_version_id String?
  created_at                DateTime      @default(now())

  project      Project       @relation(fields: [project_id], references: [id], onDelete: Cascade)
  spec_version SpecVersion   @relation("DecisionAskedAtVersion", fields: [spec_version_id], references: [id], onDelete: Cascade)
  issue_group  IssueGroup?   @relation(fields: [issue_group_id], references: [id])
  resulting    SpecVersion?  @relation("DecisionResultsInVersion", fields: [resulting_spec_version_id], references: [id])
  created      SpecVersion[] @relation("DecisionCreatesVersion")

  @@index([project_id])
  @@index([issue_group_id])
}

// ---------------------------------------------------------------- spec phụ trợ

model ExperimentPlan {
  id              String   @id @default(uuid())
  spec_version_id String   @unique
  plan            Json
  created_at      DateTime @default(now())

  spec_version SpecVersion @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)
}

model ResourceEstimate {
  id                   String   @id @default(uuid())
  spec_version_id      String   @unique
  inputs               Json
  vram_gb              Float
  hours_min            Float
  hours_max            Float
  tokens_est           Float
  cost_usd             Float
  fits_rtx3090         Boolean
  downscale_suggestion Json?
  created_at           DateTime @default(now())

  spec_version SpecVersion @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)
}

model ExportArtifact {
  id              String       @id @default(uuid())
  spec_version_id String
  format          ExportFormat
  checksum        String
  byte_size       Int
  created_at      DateTime     @default(now())

  spec_version SpecVersion @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)

  @@index([spec_version_id])
}

model VerifierRun {
  id              String   @id @default(uuid())
  spec_version_id String
  config          Json
  units_total     Int
  units_l4        Int
  label_counts    Json
  created_at      DateTime @default(now())

  spec_version SpecVersion  @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)
  card_sources CardSource[]

  @@index([spec_version_id])
}

// ---------------------------------------------------------------- job + đo

model JobRun {
  id              String    @id @default(uuid())
  project_id      String?
  spec_version_id String?
  kind            JobKind
  status          JobStatus @default(QUEUED)
  progress        Json      @default("{\"done\":0,\"total\":1}")
  message         String?
  error_code      String?
  created_at      DateTime  @default(now())
  finished_at     DateTime?

  project      Project?     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  spec_version SpecVersion? @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)
  events       JobEvent[]
  judge_runs   JudgeRun[]

  @@index([project_id])
  @@index([spec_version_id])
}

model JobEvent {
  id         String   @id @default(uuid())
  job_id     String
  seq        Int
  type       String
  payload    Json
  created_at DateTime @default(now())

  job JobRun @relation(fields: [job_id], references: [id], onDelete: Cascade)

  @@unique([job_id, seq])
  @@index([job_id])
}

model LlmCall {
  id                String     @id @default(uuid())
  purpose           LlmPurpose
  model             String
  prompt_id         String
  prompt_hash       String
  prompt_tokens     Int        @default(0)
  completion_tokens Int        @default(0)
  cache_hit_tokens  Int        @default(0)
  cache_miss_tokens Int        @default(0)
  latency_ms        Int        @default(0)
  attempts          Int        @default(1)
  ok                Boolean    @default(true)
  error_code        String?
  project_id        String?
  spec_version_id   String?
  judge_run_id      String?
  eval_run_id       String?
  created_at        DateTime   @default(now())

  project      Project?     @relation(fields: [project_id], references: [id], onDelete: Cascade)
  spec_version SpecVersion? @relation(fields: [spec_version_id], references: [id], onDelete: Cascade)
  judge_run    JudgeRun?    @relation(fields: [judge_run_id], references: [id], onDelete: Cascade)
  eval_run     EvalRun?     @relation(fields: [eval_run_id], references: [id], onDelete: Cascade)

  @@index([project_id])
  @@index([eval_run_id])
  @@index([purpose])
}

// ---------------------------------------------------------------- eval

model EvalRun {
  id           String   @id @default(uuid())
  batch_id     String
  arm          Arm
  idea_id      String
  project_id   String
  config       Json
  total_tokens Int      @default(0)
  wall_ms      Int      @default(0)
  ok           Boolean  @default(true)
  error_text   String?
  created_at   DateTime @default(now())

  project        Project        @relation(fields: [project_id], references: [id], onDelete: Cascade)
  metrics        EvalMetric[]
  auditor_scores AuditorScore[]
  llm_calls      LlmCall[]

  @@unique([batch_id, arm, idea_id])
  @@index([batch_id])
}

model EvalMetric {
  id          String   @id @default(uuid())
  eval_run_id String
  key         String
  value       Float
  created_at  DateTime @default(now())

  eval_run EvalRun @relation(fields: [eval_run_id], references: [id], onDelete: Cascade)

  @@unique([eval_run_id, key])
}

model AuditorScore {
  id              String   @id @default(uuid())
  eval_run_id     String
  blind_label     String
  severity_counts Json
  raw             Json
  created_at      DateTime @default(now())

  eval_run EvalRun @relation(fields: [eval_run_id], references: [id], onDelete: Cascade)

  @@index([eval_run_id])
}

model HumanCheck {
  id             String       @id @default(uuid())
  card_source_id String
  human_label    SupportLabel
  auto_label     SupportLabel
  match          Boolean
  note           String?
  created_at     DateTime     @default(now())

  card_source CardSource @relation(fields: [card_source_id], references: [id], onDelete: Cascade)

  @@index([card_source_id])
}

// ------------------------------------------------------- làn B · #7 bắt claim phóng đại

/**
 * Một cờ phóng đại trên một `Card(CLAIM)`.
 * `card_id` / `spec_version_id` cố ý để **scalar trần, không khai relation**. Relation của Prisma
 * đòi thêm field ngược ở `Card` và `SpecVersion`, mà luật chung 4 chỉ cho thêm dòng vào cuối
 * `schema.prisma`, không cho sửa model đang có. Đánh đổi: mất cascade delete — `OverclaimFlag`
 * phải xoá tay khi xoá version (xem `OverclaimService.clearForVersion`).
 * `Issue` **không** bị sửa (ràng buộc của #7). Cờ này sinh ra `Issue` qua judge run riêng chứ
 * không thêm cột vào bảng đó.
 */
model OverclaimFlag {
  id                  String   @id @default(uuid())
  spec_version_id     String
  card_id             String
  /// `RULE` = tầng luật 0 token · `LLM` = tầng vùng xám. Để `String` thay vì enum: luật chung 2
  /// cấm thêm giá trị vào enum đang có, và một enum mới vẫn kéo theo ba tầng phải sửa cùng lúc.
  detector            String
  /// `NONE` · `MINOR` · `MAJOR` · `CRITICAL` — chốt kiểu ở `contracts/llm-io/overclaim.ts`.
  level               String
  /// Cụm chữ trong claim khiến nó bị cờ.
  matched_terms       Json
  /// Phạm vi claim tự khai, và phạm vi đếm được trong `ExperimentPlan`.
  declared_scope      Json
  actual_scope        Json
  rationale           String
  /// Câu thu hẹp dùng được ngay. Tiêu chí hoàn thành của #7: không được chỉ là lời cảnh báo.
  suggested_narrowing String
  /// `NARROW_CLAIM` · `EXPAND_EXPERIMENT` · `TO_RESEARCH_QUESTION`.
  recommended_exit    String
  /// Đường ra người dùng đã chọn, và `Decision` ghi lại lựa chọn đó. Null khi chưa xử lý.
  chosen_exit         String?
  decision_id         String?
  /// Số token tầng LLM đã tốn cho cờ này. `0` ⇒ tầng luật kết luận một mình.
  llm_calls           Int      @default(0)
  created_at          DateTime @default(now())

  @@index([spec_version_id])
  @@index([card_id])
}

// ------------------------------------------------------- làn B · #12 bắt thẻ mơ hồ

/**
 * Một cờ mơ hồ trên một `Card`.
 * `Card.status` được gán `AMBIGUOUS` (giá trị enum **đã có**, không thêm giá trị mới — luật
 * chung 2). Nhưng gán đè là **xoá mất trạng thái cũ**, nên `previous_status` giữ lại giá trị
 * trước đó để `clearForVersion` khôi phục được. Không có nó thì quét lần hai là mất dữ liệu.
 * `card_id` / `spec_version_id` để scalar trần, không relation — cùng lý do với `OverclaimFlag`:
 * relation đòi thêm field ngược vào `Card`, mà luật chung 4 chỉ cho thêm dòng cuối file.
 */
model AmbiguityFlag {
  id                   String   @id @default(uuid())
  spec_version_id      String
  card_id              String
  /// `CLAIM_FIELD_VAGUE` · `GAP_FIELD_VAGUE` · `DANGLING_PRONOUN` · `VAGUE_TERM`.
  kind                 String
  /// Tên trường trong `payload`, null khi vấn đề nằm ở `body`.
  field                String?
  /// Đoạn chữ gây ra cờ, để người đọc kiểm lại.
  excerpt              String
  terms                Json
  reason               String
  /// Trạng thái thẻ **trước khi** bị gán `AMBIGUOUS` — để khôi phục khi quét lại.
  previous_status      String
  /// `Decision` chứa câu hỏi làm rõ sinh từ cờ này. Null khi hết hạn mức câu hỏi.
  question_decision_id String?
  created_at           DateTime @default(now())

  @@index([spec_version_id])
  @@index([card_id])
}

// ------------------------------------------------------ làn A · #1 chấm độ tin cậy của nguồn

/**
 * Điểm tin cậy của một `Source`, 1-1 theo `source_id`.
 * Tính bằng **luật thuần, 0 token** (`src/sources/credibility.ts`) và chấm lại sau mỗi lần
 * `SourcesService.searchAndStore` upsert nguồn. Bảng riêng chứ không thêm cột vào `Source`:
 * luật chung 2 cấm sửa model đang có, và tách ra thì xoá điểm đi chấm lại cũng không đụng nguồn.
 * `total` và `components` **không hiện cho người dùng** — thứ hiện ra là `tier` + `reason`.
 * Giữ lại vì #1 đòi đo tương quan giữa điểm tin cậy và nhãn `UNSUPPORTED` của verifier.
 */
model SourceScore {
  id         String   @id @default(uuid())
  source_id  String   @unique
  /// 0..1, chỉ để sắp xếp và để đo. Không phải thứ đem khoe với người dùng.
  total      Float
  /// `HIGH` · `MEDIUM` · `REVIEW`. String thay vì enum — luật chung 2.
  tier       String
  /// Một câu tiếng Việt giải thích vì sao ra mức này. Tiêu chí hoàn thành của #1.
  reason     String
  /// Điểm từng thành phần, để trang giải trình mở ra được khi bị hỏi tới.
  components Json
  scored_at  DateTime @default(now())

  @@index([tier])
}

// ------------------------------------------------- làn A · #2 verifier đọc toàn văn arXiv

/**
 * Cache toàn văn của một `Source`, khoá theo `source_id`.
 * Cache **cả lần thất bại** mới là điểm chính: phần lớn nguồn không bao giờ có bản HTML mở, và
 * không có dòng `NOT_FOUND` thì mỗi lần chạy lại đều gọi HTTP cho đúng những nguồn đó.
 * `status` chính là "cờ chẩn đoán" mà #2 đòi, nhưng ở dạng truy vấn được — thay vì thêm giá trị
 * vào `verifierFlagSchema` cho **mọi** cặp mang theo. `fulltext_hit_rate` của #6 đọc thẳng từ đây.
 * `source_id` để scalar trần, không relation — luật chung 4 chỉ cho thêm dòng vào cuối file, mà
 * relation đòi thêm field ngược ở `Source`. Đánh đổi: mất cascade delete, dọn bằng `expires_at`.
 */
model SourceFullText {
  id         String   @id @default(uuid())
  source_id  String   @unique
  /// `ARXIV_HTML` · `AR5IV`. String thay vì enum — luật chung 2.
  provider   String
  /// URL thật sự tải được, để người chấm mở lại đúng trang đó.
  url        String
  /// `OK` · `NOT_ARXIV` · `NOT_FOUND` · `TOO_SHORT` · `FETCH_ERROR`.
  status     String
  /// Đã bóc thẻ, đã cắt tài liệu tham khảo, đã cắt ở 60.000 ký tự. Rỗng khi `status != OK`.
  text       String
  char_count Int      @default(0)
  fetched_at DateTime @default(now())
  /// 30 ngày cho `OK`, 3 ngày cho thất bại — arXiv sinh HTML muộn sau khi bài lên.
  expires_at DateTime

  @@index([status])
  @@index([expires_at])
}

/**
 * Những đoạn toàn văn **thật sự gửi lên L4** cho một cặp `CardSource`, và đoạn nào chứa câu
 * chứng cứ cuối cùng.
 * Đây là dữ liệu của trang "vì sao nhãn này" (#5): một nhãn sinh từ toàn văn mà không có bảng này
 * thì không kiểm lại được, mà "kiểm lại được" là toàn bộ lý do verifier tồn tại.
 * Một dòng một đoạn chứ không gộp `Json`: trang giải trình cần lọc theo `is_evidence` và sắp theo
 * `rank`. Chỉ cặp **leo thang xuống toàn văn** mới ghi, nên số dòng ≤ 5 × số cặp leo thang.
 */
model VerifierPassage {
  id              String   @id @default(uuid())
  verifier_run_id String
  card_source_id  String
  /// Thứ hạng cosine so với khẳng định, 0 là gần nhất.
  rank            Int
  similarity      Float
  /// Vị trí đoạn trong văn bản đã bóc thẻ — để nhảy đúng chỗ khi mở lại toàn văn.
  char_start      Int      @default(0)
  text            String
  /// `true` ở đúng **một** dòng. Toàn `false` ⇒ câu chứng cứ không nằm trong đoạn nào ⇒
  /// L4b đã gắn `FABRICATED_QUOTE` và ép verdict `NOT_ENTAILED`.
  is_evidence     Boolean  @default(false)
  created_at      DateTime @default(now())

  @@index([card_source_id])
  @@index([verifier_run_id])
}

// --------------------------------------------- làn A · #3 phát hiện nguồn mâu thuẫn nhau

/**
 * Một xung đột chứng cứ trên một `Card`.
 * `Card.status` được gán `CONFLICT` — giá trị enum **đã có sẵn** trong schema và đã có màu ở
 * `frontend/src/lib/status-style.ts`, nhưng trước issue này **không dòng backend nào gán nó**,
 * y hệt câu chuyện `AMBIGUOUS` của #12. §5 đề bài liệt đây là chức năng bắt buộc.
 * `previous_status` giữ trạng thái trước khi gán đè: thiếu nó thì lần quét thứ hai đọc `CONFLICT`
 * như "trạng thái trước" và trạng thái thật mất vĩnh viễn (bài học của `AmbiguityFlag`).
 * Mọi khoá ngoài để scalar trần, không relation — luật chung 4.
 */
model CardConflict {
  id               String   @id @default(uuid())
  spec_version_id  String
  card_id          String
  /// `INTRA_CARD` (hai nguồn của cùng một thẻ chỏi nhau) · `CROSS_CARD` (cùng một bài báo bị hai
  /// thẻ dùng theo hai chiều ngược nhau). String thay vì enum — luật chung 2.
  scope            String
  /// Thẻ đối diện, **chỉ** có ở `CROSS_CARD`. Đây là giá trị được chép sang
  /// `Card.conflict_with_card_id` — cột có sẵn trong schema mà trước issue này không ai ghi.
  other_card_id    String?
  /// Hai cặp claim–nguồn gây xung đột.
  card_source_a_id String
  card_source_b_id String
  source_a_id      String
  source_b_id      String
  /// `POLARITY` · `NUMERIC` · `DIRECTION` · `LLM`.
  signal           String
  /// Chép nguyên văn hai câu chứng cứ để người đọc tự đối chiếu, không phải tin máy.
  evidence_a       String
  evidence_b       String
  /// Cặp từ trái nghĩa, hoặc tên metric kèm hai con số.
  terms            Json
  reason           String
  /// Trạng thái thẻ **trước khi** bị gán `CONFLICT` — để `clearForVersion` khôi phục được.
  previous_status  String
  /// Đường ra người dùng đã chọn, và `Decision` ghi lại lựa chọn đó. Null khi chưa xử lý.
  chosen_exit      String?
  decision_id      String?
  /// Số lời gọi LLM đã tốn cho xung đột này. `0` ⇒ tầng luật kết luận một mình.
  llm_calls        Int      @default(0)
  created_at       DateTime @default(now())

  @@index([spec_version_id])
  @@index([card_id])
}

// ------------------------------------------------- làn B · #9 đo bất đồng giữa các judge

/**
 * Một bản ghi đo cho **một vòng judge**.
 *
 * Vì sao lưu chứ không tính lúc render: `SYSTEM_DESIGN_ANALYSIS` NFR-JDG-6 —
 * *"Điểm đồng thuận phải cố định — không tính lại lúc render. F5 hai lần ra hai số là hỏng."*
 * Và #13 cần bản ghi lịch sử để so κ trước/sau khi bật #8.
 *
 * Khoá theo `(spec_version_id, round)`, **không** theo `round` một mình: `apply` reset
 * `Project.judge_round` về 0 cho version mới, nên "vòng 1" tồn tại trên nhiều version.
 *
 * `card_id` / `spec_version_id` để scalar trần, không relation — cùng lý do `OverclaimFlag` và
 * `AmbiguityFlag`: relation đòi thêm field ngược vào model đang có, mà luật chung 4 chỉ cho thêm
 * dòng vào cuối file.
 */
model JudgeAgreement {
  id              String   @id @default(uuid())
  spec_version_id String
  round           Int
  /// Số judge `status = OK` vòng đó. κ **không so được** giữa hai lần chạy khác số này.
  raters          Int
  /// Số thẻ dùng làm mục.
  items           Int
  /// `null` khi suy biến — xem `reason`. Không bao giờ trả số giả.
  kappa           Float?
  /// `NO_ITEMS` · `INSUFFICIENT_ITEMS` · `INSUFFICIENT_RATERS` · `NO_VARIANCE`.
  reason          String?
  /// Mọi người cùng một nhãn trên mọi mục — giữ riêng vì `NO_VARIANCE` làm mất thông tin này.
  unanimous       Boolean  @default(false)
  /// `IDENTICAL_ROWS` khi κ là hằng số `−1/(raters−1)`, không mang tin.
  degenerate      String?
  /// Tỉ lệ issue có gắn thẻ. Issue không gắn thẻ nằm ngoài tập mục.
  coverage        Float?
  /// Ma trận Jaccard 5×5, `solo`, `bias`, `leaveOneOut` — dạng `Json` để khỏi đẻ bốn bảng phụ.
  matrix          Json
  patterns        Json
  created_at      DateTime @default(now())

  @@unique([spec_version_id, round])
  @@index([spec_version_id])
}
