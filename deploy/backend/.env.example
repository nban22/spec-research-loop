# Đặt ở server: /opt/outsource/spec-research-loop/backend/.env  (chmod 600)
# KHÔNG commit, KHÔNG nằm trong image — chỉ được nạp lúc chạy qua `env_file` của compose.
#
# Cookie/CORS KHÔNG khai ở đây: chúng đã cố định trong docker-compose.yml vì là cấu hình
# hạ tầng, không phải bí mật.

DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DEEPSEEK_API_KEY=

# Sinh bằng: openssl rand -base64 48 — HAI CHUỖI PHẢI KHÁC NHAU
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

OPENALEX_MAILTO=you@example.com
SEMANTIC_SCHOLAR_API_KEY=
